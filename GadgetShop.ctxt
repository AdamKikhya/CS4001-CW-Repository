comment21.target=void\ displayAllAction()
comment21.text=\r\n\ Prints\ every\ gadget\ in\ the\ list\ to\ the\ output\ area\ with\ its\ index\ number.\r\n
comment22.params=
comment22.target=void\ makeCallAction()
comment22.text=\r\n\ Gets\ the\ Mobile\ at\ the\ specified\ index\ and\ calls\ makeCall().\r\n\ Shows\ a\ dialog\ if\ the\ selected\ gadget\ is\ not\ a\ Mobile.\r\n
comment23.params=
comment23.target=void\ downloadMusicAction()
comment23.text=\r\n\ Gets\ the\ MP3\ at\ the\ specified\ index\ and\ calls\ downloadMusic().\r\n\ Shows\ a\ dialog\ if\ the\ selected\ gadget\ is\ not\ an\ MP3\ player.\r\n
